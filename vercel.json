{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/_app.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "panel.agutidesigns.io"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/kit-descarga.js": {
      "includeFiles": "privado/**"
    }
  },
  "crons": [
    {
      "path": "/api/oficina/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "agutidesigns.io"
        }
      ],
      "destination": "https://panel.agutidesigns.io/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "agutidesigns.io"
        }
      ],
      "destination": "https://panel.agutidesigns.io/:path*",
      "permanent": false
    },
    {
      "source": "/oficina-ia/contratar",
      "has": [
        {
          "type": "host",
          "value": "agutidesigns.io"
        }
      ],
      "destination": "https://panel.agutidesigns.io/registro",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "www.agutidesigns.io"
        }
      ],
      "destination": "https://panel.agutidesigns.io/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.agutidesigns.io"
        }
      ],
      "destination": "https://panel.agutidesigns.io/:path*",
      "permanent": false
    },
    {
      "source": "/oficina-ia/contratar",
      "has": [
        {
          "type": "host",
          "value": "www.agutidesigns.io"
        }
      ],
      "destination": "https://panel.agutidesigns.io/registro",
      "permanent": false
    }
  ]
}